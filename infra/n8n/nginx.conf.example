# Replace n8n.example.com and the certificate paths, then place in sites-enabled.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 443 ssl;
  http2 on;
  server_name n8n.example.com;

  ssl_certificate     /etc/letsencrypt/live/n8n.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/n8n.example.com/privkey.pem;

  location / {
    proxy_pass http://127.0.0.1:5678;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;

    # n8n sends X-Frame-Options: SAMEORIGIN. Only the owner's dashboard may frame the editor.
    proxy_hide_header X-Frame-Options;
    add_header Content-Security-Policy "frame-ancestors https://maddixmhn.github.io" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
  }
}
